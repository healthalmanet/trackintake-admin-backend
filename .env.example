# ============================================================================
# TrackIntake Backend Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to git - it contains sensitive information
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string (Supabase or local PostgreSQL)
# Format: postgresql://user:password@host:port/database
# For Supabase Connection Pooler (recommended for cloud): use port 6543
# For direct connection: use port 5432
DATABASE_URL=postgresql://postgres:your-password@db.dbsrjjdvbaxrcbdyiirv.supabase.co:5432/postgres

# Alternative: Individual database components (used if DATABASE_URL not set)
DB_HOST=db.dbsrjjdvbaxrcbdyiirv.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_PORT=5432

# ============================================================================
# DJANGO SETTINGS
# ============================================================================
# Secret key for Django (generate a new one for production)
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-your-secret-key-here-change-in-production

# Debug mode (MUST be False in production)
# Set to True only for local development
DEBUG=False

# Allowed hosts - comma-separated list of domains/IPs that can access the backend
# For production: your-backend.onrender.com
# For development: localhost,127.0.0.1
# Whitespace is automatically stripped, so spacing doesn't matter
ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1

# ============================================================================
# CORS CONFIGURATION (Critical for frontend-backend communication)
# ============================================================================
# Comma-separated list of frontend origins allowed to make requests
# IMPORTANT: Must match your frontend URL exactly (including protocol and port)
# For production: https://your-frontend.onrender.com
# For development: http://localhost:5173,http://localhost:3000
# Whitespace is automatically stripped, so spacing doesn't matter
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173,http://localhost:3000

# ============================================================================
# EMAIL CONFIGURATION (For sending emails)
# ============================================================================
# Email service provider (Mailtrap for development, SendGrid/AWS SES for production)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-mailtrap-user
EMAIL_HOST_PASSWORD=your-mailtrap-password
DEFAULT_FROM_EMAIL=noreply@trackintake.com

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# These are automatically configured based on DEBUG setting
# DEBUG=False enables:
#   - SECURE_SSL_REDIRECT (force HTTPS)
#   - SESSION_COOKIE_SECURE (secure cookies)
#   - CSRF_COOKIE_SECURE (secure CSRF tokens)
#   - HSTS headers (HTTP Strict Transport Security)

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# For Render Deployment:
# 1. Set DEBUG=False
# 2. Use your Render backend URL in ALLOWED_HOSTS
# 3. Use your Render frontend URL in CORS_ALLOWED_ORIGINS
# 4. Use Supabase Connection Pooler URL (port 6543) for DATABASE_URL
# 5. Set all email credentials
#
# For Local Development:
# 1. Set DEBUG=True
# 2. Use localhost in ALLOWED_HOSTS
# 3. Use http://localhost:5173 in CORS_ALLOWED_ORIGINS
# 4. Use local PostgreSQL or Supabase direct connection
#
# For Production:
# 1. Set DEBUG=False
# 2. Generate a new SECRET_KEY
# 3. Use production domain in ALLOWED_HOSTS
# 4. Use production frontend URL in CORS_ALLOWED_ORIGINS
# 5. Use strong database password
# 6. Use production email service (SendGrid, AWS SES, etc.)
# 7. Enable HTTPS (automatic on Render)
# 8. Set up database backups
# 9. Monitor logs and errors

