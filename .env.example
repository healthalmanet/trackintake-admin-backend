# ============================================================================
# TrackIntake Backend Environment Configuration Example (.env.example)
# ============================================================================
# Copy this file to .env and replace placeholders with your actual values:
# cp .env.example .env
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string (Supabase Connection Pooler or Local PostgreSQL)
# For Supabase Connection Pooler (recommended): port 6543
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@[pooler-host]:6543/postgres?sslmode=require
# For Local PostgreSQL: port 5432
# DATABASE_URL=postgresql://postgres:password@localhost:5432/trackintake_db
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Alternative individual components (used only if DATABASE_URL is not set):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-password

# ============================================================================
# DJANGO SETTINGS
# ============================================================================
# Secret key for Django (generate a new one for production)
SECRET_KEY=django-insecure-trackintake-admin-secret-key-2026-development

# Debug mode: Set to True for local development, False for production
DEBUG=True

# Allowed hosts: comma-separated list of domains / IPs
# For local development: localhost,127.0.0.1
# For production: your-backend.onrender.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of frontend origins allowed to make API requests
# For local development: http://localhost:5173,http://localhost:3000
# For production: https://your-frontend.onrender.com,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
# Development: Mailtrap / Sandbox
# Production: SendGrid / AWS SES / Gmail SMTP
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-mailtrap-username
EMAIL_HOST_PASSWORD=your-mailtrap-password
DEFAULT_FROM_EMAIL=noreply@trackintake.com
